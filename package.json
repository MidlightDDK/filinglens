{
  "name": "filinglens",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @filinglens/web --filter @filinglens/worker dev",
    "data:ingest": "uv run --project pipeline python -m pipeline.ingest",
    "data:chunk": "uv run --project pipeline python -m pipeline.chunk",
    "data:xbrl": "uv run --project pipeline python -m pipeline.xbrl",
    "index": "node scripts/src/build-index.ts",
    "examples": "node -e \"console.log('examples: not implemented (M6)')\"",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "vitest run",
    "e2e": "pnpm --filter @filinglens/web e2e",
    "eval:synth": "node evals/src/synth.ts",
    "eval:import": "node evals/src/import.ts",
    "eval:retrieval": "node evals/src/retrieval.ts",
    "eval:answers": "node evals/src/answers.ts",
    "eval:judge": "node evals/src/judge.ts",
    "build": "pnpm --filter @filinglens/web build && pnpm --filter @filinglens/worker build",
    "deploy": "pnpm build && pnpm --filter @filinglens/worker run deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.14",
    "@types/node": "^26.6.2",
    "typescript": "^7.0.2",
    "vitest": "^5.0.1"
  }
}
