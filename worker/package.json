{
  "name": "@filinglens/worker",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node -e \"require('fs').mkdirSync('../web/dist',{recursive:true})\" && wrangler dev",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260924.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.137.0"
  }
}
