{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "filinglens",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-24",
  "assets": {
    "directory": "../web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "ai": { "binding": "AI" },
  "kv_namespaces": [
    { "binding": "ANSWER_CACHE", "id": "57736ae17e0b4c6082910344f1c732cd" }
  ],
  // Approximate and per Cloudflare location; period must be 10 or 60 s
  // (https://developers.cloudflare.com/workers/runtime-apis/bindings/rate-limit/).
  "ratelimits": [
    {
      "name": "RL_ANSWER",
      "namespace_id": "1001",
      "simple": { "limit": 6, "period": 60 }
    },
    {
      "name": "RL_OTHER",
      "namespace_id": "1002",
      "simple": { "limit": 30, "period": 60 }
    }
  ]
}
